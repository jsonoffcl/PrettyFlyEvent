# Camera originals and video — ~490MB, and none of it is served.
# build-web-images.sh reads these to produce the web slots; the slots are committed,
# the sources are not. Keep this folder backed up somewhere that isn't git.
images/*/IMG_*
*.mp4
*.MP4
*.mov
*.MOV
*.heic
*.HEIC

# macOS
.DS_Store
._*

# Build output — regenerated by build-web-images.sh on every run
images/slot-dimensions.txt

# Local tooling
.claude/
.netlify/
